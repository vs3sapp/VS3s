const SUPABASE_URL = 'https://YOUR-PROJECT.supabase.co'
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR-ANON-KEY'
// ==================================

import { createClient } from 'https://esm.sh/@supabase/supabase-js@2'

const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY)

// DEBUG: Show on screen
document.body.innerHTML = `
  <div style="padding:20px; font-family:sans-serif; color:white; background:#111; min-height:100vh">
    <h1>VS3s App Ready ✅</h1>
    <p>If you see this, JS is working!</p>
    <button id="testBtn" style="padding:10px; background:green; color:white; border:none; border-radius:8px">
      Test View Later Button
    </button>
    <pre id="output" style="margin-top:20px; background:#222; padding:10px"></pre>
  </div>
`

const output = document.getElementById('output')

async function testViewLater() {
  output.innerText = 'Testing Supabase connection...'
  
  // 1. Test fetch profiles
  const { data: profiles, error: profileError } = await supabase
    .from('online_profiles')
    .select('*')
    .limit(1)
  
  if(profileError) {
    output.innerText = 'ERROR fetching profiles: ' + profileError.message
    return
  }
  
  output.innerText = `Found ${profiles.length} profiles. Testing insert...\n`

  // 2. Test insert
  const { data, error } = await supabase
    .from('view_later_queue')
    .insert([{ profile_id: 'test-123' }])
    .select()

  if (error) {
    output.innerText += 'ERROR inserting: ' + error.message
  } else {
    output.innerText += 'SUCCESS! Inserted: ' + JSON.stringify(data)
  }
}

document.getElementById('testBtn').onclick = testViewLater
